# Copy to .env and fill in. .env is git-ignored.
# With no API key for the selected provider, the app runs in DEMO MODE
# (cached results, no API calls).

# Which AI provider classifies messages: gemini (default, free tier) or anthropic
LLM_PROVIDER=gemini

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional paid alternative
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
